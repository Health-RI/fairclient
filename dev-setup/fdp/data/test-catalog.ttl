@prefix dct: <http://purl.org/dc/terms/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
@prefix fdp: <http://fdp.test/>.

fdp:new
    a dcat:Catalog, dcat:Resource;
    dct:description "Test catalog - description";
    dct:isPartOf <http://fdp.test>;
    dct:publisher
            [
                a foaf:Agent;
                foaf:name "Test catalog - Publisher"
            ];
    dct:title "Test catalog";
    dcat:version "1.0".
